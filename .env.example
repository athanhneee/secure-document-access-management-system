# Secure Document Access System — Root Environment Placeholders
# DO NOT PUT REAL CREDENTIALS IN THIS FILE.

# 1. Runtime, Network & Web Frontend (@sda/api & @sda/web)
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
API_HOST=127.0.0.1
API_PORT=3001
TRUST_PROXY=loopback
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ABAC_TRUSTED_NETWORK_CIDRS=127.0.0.0/8,::1/128
LOG_LEVEL=info
INTERNAL_API_ORIGIN=http://127.0.0.1:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
CSP_CONNECT_ORIGINS=
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
NEXT_TELEMETRY_DISABLED=1

# 2. PostgreSQL & Strict TLS (@sda/database)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public
DIRECT_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_CA_CERT=/etc/ssl/certs/postgres-root-ca.crt

# 3. Redis & Redlock Distributed Consensus
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:6379/0
# REDLOCK_CLUSTER_NODES=redis://node1:6379/0,redis://node2:6379/0,redis://node3:6379/0
REDLOCK_RETRY_COUNT=10
REDLOCK_RETRY_DELAY_MS=100
REDLOCK_RETRY_JITTER_MS=50
REDLOCK_DEFAULT_TTL_MS=5000
REDLOCK_FAIL_CLOSED=true

# 4. S3 / Cloudflare R2 Object Storage & Ingestion Safeguards
STORAGE_MOCK=false
STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=<STORAGE_ACCESS_KEY>
STORAGE_SECRET_KEY=<STORAGE_SECRET_KEY>
STORAGE_BUCKET_DOCUMENTS=secure-documents
STORAGE_BUCKET_QUARANTINE=secure-quarantine
STORAGE_BUCKET_DERIVATIVES=secure-derivatives
STORAGE_USE_SSL=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
GOTENBERG_URL=http://127.0.0.1:3003
GOTENBERG_ENABLED=true
UPLOAD_MAX_FILE_SIZE_BYTES=52428800
ZIP_MAX_TOTAL_UNCOMPRESSED_SIZE=209715200
ZIP_MAX_ENTRIES=1000
ZIP_MAX_DEPTH=5
ZIP_MAX_COMPRESSION_RATIO=20
DOWNLOAD_TICKET_TTL_SECONDS=60
DERIVATIVE_TTL_MINUTES=60
GRANT_MAX_DURATION_DAYS=30

# 5. Cryptography, KMS, JWT & WebAuthn
APP_ENCRYPTION_MASTER_KEY=<PLACEHOLDER_32_BYTE_HEX_MASTER_KEY>
AUDIT_INTEGRITY_KEY=<PLACEHOLDER_32_BYTE_HEX_AUDIT_HMAC_KEY>
DOCUMENT_AUDIT_HMAC_KEY=<PLACEHOLDER_32_BYTE_HEX_DOC_AUDIT_KEY>
AUTH_AUDIT_HMAC_KEY=<PLACEHOLDER_32_BYTE_HEX_AUTH_AUDIT_KEY>
# AUDIT_KEY_ROTATION_JSON={"1":"<PLACEHOLDER_LEGACY_AUDIT_HMAC_KEY>"}
KMS_PROVIDER=local
HSM_PIN=<HSM_USER_PIN>
HSM_SLOT_INDEX=0
HSM_KEY_LABEL=SDA-MASTER-KEK-v1
# HSM_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=<VAULT_TOKEN_PLACEHOLDER>
VAULT_KEY_NAME=sda-document-kek
VAULT_TRANSIT_MOUNT=transit
AWS_KMS_KEY_ID=alias/sda-master-kek
AWS_KMS_REGION=us-east-1
AUTH_ISSUER=secure-document-access-api
AUTH_AUDIENCE=secure-document-access-web
AUTH_ACTIVE_KID=development-ephemeral
# AUTH_SIGNING_PRIVATE_KEY_PEM=<PLACEHOLDER_ED25519_PRIVATE_KEY_PEM>
# AUTH_SIGNING_PUBLIC_KEYS_JSON={"kid-1":"<PLACEHOLDER_ED25519_PUBLIC_KEY_PEM>"}
AUTH_ACCESS_TTL_SECONDS=300
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_SESSION_IDLE_TTL_SECONDS=28800
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=60
AUTH_MAX_CONCURRENT_SESSIONS=10
AUTH_RESET_TTL_SECONDS=900
WEBAUTHN_RP_NAME=Secure Document Access
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 6. SMTP Delivery & Password Reset
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=<SMTP_USERNAME>
# SMTP_PASS=<SMTP_PASSWORD>
SMTP_FROM=no-reply@secure-docs.internal
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# 7. Async Exports, Worker Schedulers & Prometheus Scrape Auth (@sda/worker & @sda/api)
EXPORT_STORAGE_DIR=.local/exports
EXPORT_ENCRYPTION_KEY=<PLACEHOLDER_32_BYTE_HEX_EXPORT_KEY>
EXPORT_EXECUTION_MODE=worker
EXPORT_PROCESSOR_INTERVAL_MS=5000
EXPORT_CLEANUP_INTERVAL_MS=300000
GRANT_EXPIRY_INTERVAL_MS=60000
DERIVATIVE_CLEANUP_INTERVAL_MS=300000
AUTH_SESSION_CLEANUP_INTERVAL_MS=300000
AUTH_SESSION_RETENTION_DAYS=30
AUDIT_VERIFY_INTERVAL_MS=300000
SECURITY_DETECTION_INTERVAL_MS=60000
NOTIFICATION_OUTBOX_INTERVAL_MS=15000
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=9102
# METRICS_SCRAPE_TOKEN=<PLACEHOLDER_METRICS_SCRAPE_BEARER_TOKEN>

# 8. Network DLP (ICAP RFC 3507 Server — action: BLOCK | AUDIT_ONLY)
ICAP_SERVER_ENABLED=true
ICAP_BIND_HOST=127.0.0.1
ICAP_PORT=1344
ICAP_SERVER_HOST=127.0.0.1
ICAP_SERVER_PORT=1344
ICAP_MAX_CONCURRENT_INSPECTIONS=16
ICAP_DLP_ACTION=BLOCK
ICAP_DLP_CUSTOM_KEYWORDS=
