# Secure Document Access System — Root Environment Placeholders
# DO NOT PUT REAL CREDENTIALS IN THIS FILE.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
PORT=3000
NEXT_TELEMETRY_DISABLED=1

DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:6379/0
ABAC_TRUSTED_NETWORK_CIDRS=127.0.0.0/8,::1/128

STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=<STORAGE_ACCESS_KEY>
STORAGE_SECRET_KEY=<STORAGE_SECRET_KEY>
STORAGE_BUCKET_DOCUMENTS=secure-documents
STORAGE_BUCKET_QUARANTINE=secure-quarantine
STORAGE_BUCKET_DERIVATIVES=secure-derivatives
STORAGE_USE_SSL=false

CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

APP_ENCRYPTION_MASTER_KEY=<PLACEHOLDER_32_BYTE_HEX_MASTER_KEY>
