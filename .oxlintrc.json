{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "nextjs"],
  "categories": { "correctness": "error" },
  "rules": { "typescript/no-explicit-any": "error" },
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/node_modules/**",
    "docs/reference/**",
    ".tools/**",
    ".pnpm-store/**"
  ]
}
