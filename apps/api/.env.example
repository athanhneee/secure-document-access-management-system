# Secure Document Access System — Environment Placeholders
# DO NOT PUT REAL CREDENTIALS IN THIS FILE.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Connection String
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public

# Redis Connection URL & Redlock Distributed Locking
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:6379/0
# REDLOCK_CLUSTER_NODES=redis://node1:6379/0,redis://node2:6379/0,redis://node3:6379/0
REDLOCK_RETRY_COUNT=10
REDLOCK_RETRY_DELAY_MS=100
REDLOCK_DEFAULT_TTL_MS=5000
REDLOCK_FAIL_CLOSED=false
ABAC_TRUSTED_NETWORK_CIDRS=127.0.0.0/8,::1/128

# S3-Compatible Object Storage (MinIO / AWS S3)
STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=<STORAGE_ACCESS_KEY>
STORAGE_SECRET_KEY=<STORAGE_SECRET_KEY>
STORAGE_BUCKET_DOCUMENTS=secure-documents
STORAGE_BUCKET_QUARANTINE=secure-quarantine
STORAGE_BUCKET_DERIVATIVES=secure-derivatives
STORAGE_USE_SSL=false

# Logging Level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Malware scanner and local mail sink
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
GOTENBERG_URL=http://127.0.0.1:3003
GOTENBERG_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@secure-docs.internal

# Master Key for Envelope Encryption (32-byte hex minimum)
APP_ENCRYPTION_MASTER_KEY=<PLACEHOLDER_32_BYTE_HEX_MASTER_KEY>

# Pluggable KMS Provider: local | hsm-pkcs11 | vault | aws-kms
KMS_PROVIDER=local
HSM_PIN=<HSM_USER_PIN>
HSM_SLOT_INDEX=0
HSM_KEY_LABEL=SDA-MASTER-KEK-v1
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=<VAULT_TOKEN>
VAULT_KEY_NAME=sda-document-kek
VAULT_TRANSIT_MOUNT=transit
AWS_KMS_KEY_ID=alias/sda-master-kek
AWS_KMS_REGION=us-east-1

# Authentication keys are injected by the deployment secret manager.
AUTH_ISSUER=secure-document-access-api
AUTH_AUDIENCE=secure-document-access-web
AUTH_ACTIVE_KID=2026-09-primary
AUTH_SIGNING_PRIVATE_KEY_PEM=<PKCS8_ED25519_PRIVATE_KEY_WITH_ESCAPED_NEWLINES>
AUTH_SIGNING_PUBLIC_KEYS_JSON=<JSON_ARRAY_OF_KID_AND_SPKI_PUBLIC_KEY>
AUTH_ACCESS_TTL_SECONDS=300
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_RESET_TTL_SECONDS=900
AUTH_AUDIT_HMAC_KEY=<PLACEHOLDER_32_BYTE_MINIMUM_HMAC_KEY>
AUDIT_INTEGRITY_KEY=<PLACEHOLDER_32_BYTE_MINIMUM_HMAC_KEY>
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# FIDO2 / WebAuthn Configuration
WEBAUTHN_RP_NAME=Secure Document Access
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

