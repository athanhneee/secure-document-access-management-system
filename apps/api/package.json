{
  "name": "@sda/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "lint": "oxlint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "10.0.2",
    "@fastify/multipart": "^10.1.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@sda/contracts": "workspace:*",
    "@sda/database": "workspace:*",
    "@sda/security": "workspace:*",
    "@standard-schema/spec": "1.0.0",
    "argon2": "^0.45.1",
    "fastify": "5.12.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.5.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yauzl": "^3.4.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@sda/testing": "workspace:*",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^3.4.0",
    "pg": "8.23.0",
    "prisma": "7.10.0"
  }
}
