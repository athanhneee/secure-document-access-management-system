{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Overview & SLA / NFR Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "HTTP Throughput (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (method, route)",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "HTTP Latency (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "HTTP Error Rate (5xx)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) or vector(0)",
          "legendFormat": "5xx Ratio"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "orange", "value": 100 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active Sessions",
      "type": "stat",
      "targets": [
        {
          "expr": "active_access_sessions or vector(0)",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Zero-Trust Policy Engine (PDP) & Security Detection",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 5,
      "title": "PDP Decisions (PERMIT vs DENY)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(pdp_evaluations_total[1m])) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "id": 6,
      "title": "PDP Evaluation Latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pdp_evaluation_duration_seconds_bucket[5m])) by (le, decision))",
          "legendFormat": "p95 {{decision}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 8 },
      "id": 7,
      "title": "Audit Chain Tamper Violations",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(audit_verify_failures_total) or vector(0)",
          "legendFormat": "Violations"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 8 },
      "id": 8,
      "title": "Security Alerts Total",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(security_alerts_total) by (severity)",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Worker Queues, Ingestion & Watermarking",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 15 },
      "id": 9,
      "title": "Worker Queue Depth / Backlog",
      "type": "timeseries",
      "targets": [
        {
          "expr": "worker_queue_depth",
          "legendFormat": "Queue: {{queue}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 15 },
      "id": 10,
      "title": "Watermark Render Latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(watermark_render_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Watermark p95"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "local-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 15 },
      "id": 11,
      "title": "Antivirus Scan Duration (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(antivirus_scan_duration_seconds_bucket[5m])) by (le, result))",
          "legendFormat": "Scan p95: {{result}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["sda", "security", "sre", "zero-trust"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "SDA - Production Reliability & Security Dashboard",
  "uid": "sda-prod-overview",
  "version": 1
}
