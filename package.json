{
  "name": "secure-document-access-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "12.4.1"
  },
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "prepare": "husky",
    "dev": "turbo run build --filter=!@sda/web && turbo run dev",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings scripts test e2e playwright.config.ts && turbo run lint",
    "typecheck": "tsc --project tsconfig.json --noEmit && turbo run typecheck",
    "test": "node --test test/unit/*.test.mjs && turbo run test",
    "test:unit": "node --test test/unit/*.test.mjs && turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run build && playwright test",
    "test:infra": "node scripts/run-infra-tests.mjs",
    "db:migrate": "pnpm --filter @sda/database prisma:migrate",
    "db:seed": "pnpm --filter @sda/database prisma:seed",
    "db:validate": "pnpm --filter @sda/database prisma:validate && pnpm --filter @sda/database prisma:generate && node scripts/validate-database.mjs",
    "generate-dev-secrets": "node scripts/generate-dev-secrets.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:reset-safe": "node scripts/infra.mjs reset-safe",
    "infra:doctor": "node scripts/infra.mjs doctor",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:dependencies": "pnpm audit --audit-level=high",
    "security:scan": "pnpm security:secrets && pnpm security:dependencies",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:e2e && pnpm test:infra && pnpm db:validate && pnpm security:scan"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
