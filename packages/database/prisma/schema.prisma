  user_id             BigInt
  ip_address          String              @db.Inet
  user_agent          String?
  device_fingerprint  String?             @db.VarChar(255)
  status              session_status      @default(ACTIVE)
  started_at          DateTime            @default(now()) @db.Timestamptz(6)
