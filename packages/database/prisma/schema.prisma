generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AccessGrantPermission {
  access_grant_id String          @db.Uuid
  permission      permission_code
  access_grants   AccessGrant     @relation(fields: [access_grant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([access_grant_id, permission])
  @@map("access_grant_permissions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AccessGrant {
  id                                           String                  @id @db.Uuid
  document_id                                  String                  @db.Uuid
  principal_type                               principal_type
  principal_user_id                            BigInt?
  principal_role_id                            BigInt?
  source                                       grant_source
  access_request_id                            String?                 @db.Uuid
  valid_from                                   DateTime                @db.Timestamptz(6)
  valid_until                                  DateTime                @db.Timestamptz(6)
  status                                       grant_status            @default(ACTIVE)
  granted_by                                   BigInt
  granted_at                                   DateTime                @default(now()) @db.Timestamptz(6)
  revoked_by                                   BigInt?
  revoked_at                                   DateTime?               @db.Timestamptz(6)
  revoke_reason                                String?
  version                                      Int                     @default(0)
  access_grant_permissions                     AccessGrantPermission[]
  access_requests                              AccessRequest?          @relation(fields: [access_request_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  documents                                    Document                @relation(fields: [document_id], references: [id], onUpdate: NoAction)
  users_access_grants_granted_byTousers        User                    @relation("access_grants_granted_byTousers", fields: [granted_by], references: [id], onUpdate: NoAction)
  roles                                        Role?                   @relation(fields: [principal_role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_access_grants_principal_user_idTousers User?                   @relation("access_grants_principal_user_idTousers", fields: [principal_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_access_grants_revoked_byTousers        User?                   @relation("access_grants_revoked_byTousers", fields: [revoked_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  access_sessions                              AccessSession[]

  @@index([principal_role_id, document_id, status, valid_until], map: "idx_access_grants_role_active")
  @@index([principal_user_id, document_id, status, valid_until], map: "idx_access_grants_user_active")
  @@map("access_grants")
}

