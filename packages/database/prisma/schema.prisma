  @@index([document_id, status, submitted_at], map: "idx_access_requests_owner_queue")
  @@index([requester_id, status, submitted_at(sort: Desc)], map: "idx_access_requests_requester")
  @@map("access_requests")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AccessSession {
  id                  String              @id @db.Uuid
  access_grant_id     String              @db.Uuid
