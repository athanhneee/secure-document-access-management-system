model AlertAuditLink {
  alert_id        String        @db.Uuid
  audit_log_id    BigInt
  security_alerts SecurityAlert @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  audit_logs      AuditLog      @relation(fields: [audit_log_id], references: [id], onUpdate: NoAction)

  @@id([alert_id, audit_log_id])
  @@map("alert_audit_links")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AuditLog {
  id                BigInt           @id @default(autoincrement())
  occurred_at       DateTime         @default(now()) @db.Timestamptz(6)
  actor_user_id     BigInt?
  actor_username    String?          @db.VarChar(80)
  action            String           @db.VarChar(100)
  object_type       String           @db.VarChar(80)
  object_id         String?          @db.VarChar(100)
  document_id       String?          @db.Uuid
  access_session_id String?          @db.Uuid
  outcome           String           @db.VarChar(20)
  reason_code       String?          @db.VarChar(80)
  ip_address        String?          @db.Inet
  user_agent        String?
  correlation_id    String           @db.Uuid
  details           Json             @default("{}")
  previous_hash     String?          @db.Char(64)
  entry_hash        String           @db.Char(64)
  chain_partition   String           @default("GLOBAL") @db.VarChar(80)
  chain_sequence    BigInt
  hmac_key_version  Int              @default(1)
  chain_algorithm   String           @default("HMAC-SHA-256") @db.VarChar(20)
  alert_audit_links AlertAuditLink[]
  access_sessions   AccessSession?   @relation(fields: [access_session_id], references: [id], onUpdate: NoAction)
  users             User?            @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)
  documents         Document?        @relation(fields: [document_id], references: [id], onUpdate: NoAction)

  @@unique([chain_partition, entry_hash], map: "uq_audit_chain_entry_hash")
  @@unique([chain_partition, chain_sequence], map: "uq_audit_chain_position")
  @@index([action, occurred_at(sort: Desc)], map: "idx_audit_action_time")
  @@index([actor_user_id, occurred_at(sort: Desc)], map: "idx_audit_actor_time")
  @@index([details], map: "idx_audit_details_gin", type: Gin)
  @@index([document_id, occurred_at(sort: Desc)], map: "idx_audit_document_time")
  @@index([outcome, occurred_at(sort: Desc)], map: "idx_audit_outcome_time")
  @@index([chain_partition, occurred_at(sort: Desc)], map: "idx_audit_partition_time")
  @@index([occurred_at(sort: Desc)], map: "idx_audit_occurred_at")
  @@map("audit_logs")
}

model AuditAnchor {
  id              BigInt   @id @default(autoincrement())
  chain_partition String   @db.VarChar(80)
  anchor_sequence BigInt
  entry_hash      String   @db.Char(64)
  anchored_at     DateTime @default(now()) @db.Timestamptz(6)
  signature       String   @db.VarChar(512)
  signer_key_id   String   @db.VarChar(80)
  status          String   @default("VALID") @db.VarChar(20)

  @@index([chain_partition, anchor_sequence(sort: Desc)], map: "idx_audit_anchor_partition")
  @@map("audit_anchors")
}

