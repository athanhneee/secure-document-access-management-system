model Department {
  id                  BigInt             @id @default(autoincrement())
  code                String             @unique @db.VarChar(30)
  name                String             @db.VarChar(150)
  parent_id           BigInt?
  is_active           Boolean            @default(true)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @default(now()) @db.Timestamptz(6)
  version             Int                @default(0)
  business_categories BusinessCategory[]
  departments         Department?        @relation("departmentsTodepartments", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_departments   Department[]       @relation("departmentsTodepartments")
  documents           Document[]
  user_roles          UserRole[]
  users               User[]

  @@map("departments")
}

model Permission {
  id               BigInt           @id @default(autoincrement())
  code             String           @unique @db.VarChar(80)
  name             String           @db.VarChar(150)
  resource_type    String           @db.VarChar(80)
  action           String           @db.VarChar(80)
  description      String?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  role_permissions RolePermission[]

  @@unique([resource_type, action])
  @@map("permissions")
}

model RolePermission {
  role_id       BigInt
  permission_id BigInt
  granted_by    BigInt
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  users         User       @relation(fields: [granted_by], references: [id], onUpdate: NoAction)
  permissions   Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         Role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model Role {
  id               BigInt           @id @default(autoincrement())
  code             String           @unique @db.VarChar(50)
  name             String           @db.VarChar(120)
  description      String?
  is_system_role   Boolean          @default(false)
  is_active        Boolean          @default(true)
  created_by       BigInt?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  version          Int              @default(0)
  access_grants    AccessGrant[]
  role_permissions RolePermission[]
  users            User?            @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  user_roles       UserRole[]

  @@map("roles")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model UserRole {
  id                                  BigInt      @id @default(autoincrement())
  user_id                             BigInt
  role_id                             BigInt
  scope_department_id                 BigInt?
  valid_from                          DateTime    @default(now()) @db.Timestamptz(6)
  valid_to                            DateTime?   @db.Timestamptz(6)
  assigned_by                         BigInt
  created_at                          DateTime    @default(now()) @db.Timestamptz(6)
  users_user_roles_assigned_byTousers User        @relation("user_roles_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction)
  roles                               Role        @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  departments                         Department? @relation(fields: [scope_department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_user_roles_user_idTousers     User        @relation("user_roles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id, scope_department_id, valid_from])
  @@index([user_id, role_id, valid_from, valid_to], map: "idx_user_roles_active")
  @@map("user_roles")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model User {
  id                                                                       BigInt                          @id @default(autoincrement())
  username                                                                 String                          @unique @db.VarChar(80)
  email                                                                    String                          @unique @db.VarChar(255)
  password_hash                                                            String                          @db.VarChar(255)
  full_name                                                                String                          @db.VarChar(150)
  employee_code                                                            String?                         @unique @db.VarChar(50)
  department_id                                                            BigInt?
  status                                                                   user_status                     @default(PENDING)
  failed_login_count                                                       Int                             @default(0)
  locked_until                                                             DateTime?                       @db.Timestamptz(6)
  last_login_at                                                            DateTime?                       @db.Timestamptz(6)
  created_by                                                               BigInt?
  created_at                                                               DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                                                               DateTime                        @default(now()) @db.Timestamptz(6)
  disabled_at                                                              DateTime?                       @db.Timestamptz(6)
  version                                                                  Int                             @default(0)
  access_grants_access_grants_granted_byTousers                            AccessGrant[]                   @relation("access_grants_granted_byTousers")
  access_grants_access_grants_principal_user_idTousers                     AccessGrant[]                   @relation("access_grants_principal_user_idTousers")
  access_grants_access_grants_revoked_byTousers                            AccessGrant[]                   @relation("access_grants_revoked_byTousers")
  access_request_decisions                                                 AccessRequestDecision[]
  access_requests                                                          AccessRequest[]
  access_sessions                                                          AccessSession[]
  attribute_definitions                                                    AttributeDefinition[]
  audit_logs                                                               AuditLog[]
  document_classification_history                                          DocumentClassificationHistory[]
  document_versions                                                        DocumentVersion[]
  documents                                                                Document[]
  incident_actions                                                         IncidentAction[]
  incident_reports_incident_reports_prepared_byTousers                     IncidentReport[]                @relation("incident_reports_prepared_byTousers")
  incident_reports_incident_reports_submitted_to_adminTousers              IncidentReport[]                @relation("incident_reports_submitted_to_adminTousers")
  incident_reports_incident_reports_submitted_to_ownerTousers              IncidentReport[]                @relation("incident_reports_submitted_to_ownerTousers")
  notifications                                                            Notification[]
  policy_rules                                                             PolicyRule[]
  role_permissions                                                         RolePermission[]
  roles                                                                    Role[]
  security_alerts_security_alerts_assigned_toTousers                       SecurityAlert[]                 @relation("security_alerts_assigned_toTousers")
  security_alerts_security_alerts_detected_user_idTousers                  SecurityAlert[]                 @relation("security_alerts_detected_user_idTousers")
  user_attribute_assignments_user_attribute_assignments_assigned_byTousers UserAttributeAssignment[]       @relation("user_attribute_assignments_assigned_byTousers")
  user_attribute_assignments_user_attribute_assignments_user_idTousers     UserAttributeAssignment[]       @relation("user_attribute_assignments_user_idTousers")
  user_roles_user_roles_assigned_byTousers                                 UserRole[]                      @relation("user_roles_assigned_byTousers")
  user_roles_user_roles_user_idTousers                                     UserRole[]                      @relation("user_roles_user_idTousers")
  users                                                                    User?                           @relation("usersTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  other_users                                                              User[]                          @relation("usersTousers")
  departments                                                              Department?                     @relation(fields: [department_id], references: [id], onUpdate: NoAction)
  watermark_configs                                                        WatermarkConfig[]
  watermark_instances                                                      WatermarkInstance[]
  auth_sessions                                                            AuthSession[]
  mfa_methods                                                              MfaMethod[]
  password_reset_tokens                                                    PasswordResetToken[]
  notification_outbox                                                      NotificationOutbox[]
  async_export_jobs                                                        AsyncExportJob[]
  detection_rule_configs                                                   DetectionRuleConfig[]

  @@index([department_id, status], map: "idx_users_department_status")
  @@map("users")
}

model AuthSession {
  id                String              @id @db.Uuid
  user_id           BigInt
  token_family_id   String              @unique @db.Uuid
  status            auth_session_status @default(ACTIVE)
  ip_address        String?             @db.Inet
  user_agent        String?
  mfa_verified_at   DateTime?           @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  last_seen_at      DateTime            @default(now()) @db.Timestamptz(6)
  expires_at        DateTime            @db.Timestamptz(6)
  revoked_at        DateTime?           @db.Timestamptz(6)
  revocation_reason String?             @db.VarChar(80)
  users             User                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refresh_tokens    RefreshToken[]

  @@index([user_id, status, expires_at], map: "idx_auth_sessions_user_status")
  @@map("auth_sessions")
}

model RefreshToken {
  id                String         @id @db.Uuid
  auth_session_id   String         @db.Uuid
  token_family_id   String         @db.Uuid
  token_hash        String         @unique @db.Char(64)
  parent_token_id   String?        @db.Uuid
  issued_at         DateTime       @default(now()) @db.Timestamptz(6)
  expires_at        DateTime       @db.Timestamptz(6)
  used_at           DateTime?      @db.Timestamptz(6)
  revoked_at        DateTime?      @db.Timestamptz(6)
  revocation_reason String?        @db.VarChar(80)
  auth_sessions     AuthSession    @relation(fields: [auth_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent            RefreshToken?  @relation("refresh_token_rotation", fields: [parent_token_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replacements      RefreshToken[] @relation("refresh_token_rotation")

  @@index([auth_session_id, expires_at], map: "idx_refresh_tokens_session_expiry")
  @@index([token_family_id, revoked_at], map: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

model MfaMethod {
  id                   String          @id @db.Uuid
  user_id              BigInt
  method_type          mfa_method_type @default(TOTP)
  label                String?         @db.VarChar(80)
  secret_encrypted     String
  recovery_code_hashes Json            @default("[]")
  verified_at          DateTime?       @db.Timestamptz(6)
  enabled_at           DateTime?       @db.Timestamptz(6)
  disabled_at          DateTime?       @db.Timestamptz(6)
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  users                User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, enabled_at, disabled_at], map: "idx_mfa_methods_user_active")
  @@map("mfa_methods")
}

model PasswordResetToken {
  id           String    @id @db.Uuid
  user_id      BigInt
  token_hash   String    @unique @db.Char(64)
  requested_ip String?   @db.Inet
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  expires_at   DateTime  @db.Timestamptz(6)
  used_at      DateTime? @db.Timestamptz(6)
  users        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, expires_at], map: "idx_password_reset_user_expiry")
  @@map("password_reset_tokens")
}
